  "cards": [
    {
      "dot": "cyan",
      "title": "Mechanism decides the licence",
      "items": [
        "TOOL-LIC-020: strong copyleft may be invoked as a separate process, never linked into the tool.",
        "So the GPL row above is safe: gcov, OpenOCD and QEMU are all subprocesses."
      ]
    },
    {
      "dot": "emerald",
      "title": "Three different link targets",
      "items": [
        "LINKED goes into the tool binary, so it must be permissive.",
        "HARNESS LINK goes into the user's test binary, so the licence flows to the user, not to us.",
        "SUBPROCESS goes nowhere; it is a separate program."
      ]
    },
    {
      "dot": "amber",
      "title": "The keystone and the trap",
      "items": [
        "libgcov links into the user's binary but carries the GCC Runtime Library Exception, so the harness is not made GPL.",
        "The gcov binary carries no such exception, and stays a subprocess.",
        "gcov data is version-locked to the exact GCC that built the object."
      ]
    },
    {
      "dot": "slate",
      "title": "Scope of this view",
      "items": [
        "External attachments only. Component-to-component dependencies are in diagrams/.",
        "Not checked by trace_check.py: third-party projects are deliberately not register components."
      ]
    }
  ]
