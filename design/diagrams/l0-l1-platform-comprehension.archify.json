  "cards": [
    {
      "dot": "cyan",
      "title": "L1 · Comprehension",
      "items": [
        "Reads user code and build configuration, produces models, writes no generated code.",
        "CMP-ANA is the only component that drives a C front-end; everything above it consumes its model."
      ]
    },
    {
      "dot": "emerald",
      "title": "L0 · Platform and Persistence",
      "items": [
        "Depends on nothing above it; every other layer may depend on it.",
        "CMP-CORE owns determinism, error handling, cancellation and provenance so no other component re-implements them."
      ]
    },
    {
      "dot": "amber",
      "title": "The one upward edge",
      "items": [
        "CMP-TCH → CMP-PLG points up into L6, which strict layering forbids.",
        "It is legal only because CMP-PLG is marked cross_cutting in the register."
      ]
    }
  ]
