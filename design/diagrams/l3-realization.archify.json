  "cards": [
    {
      "dot": "cyan",
      "title": "L3 · Realization",
      "items": [
        "CMP-BLD turns generated source into an executable; the two runners execute it.",
        "Host and target execution are separate components, not one runner with a flag."
      ]
    },
    {
      "dot": "emerald",
      "title": "Why the runners mirror",
      "items": [
        "CMP-EXH and CMP-EXT depend on the same four things: the build, the platform, security and the case store.",
        "The difference is where the binary runs, not what it needs to run."
      ]
    },
    {
      "dot": "amber",
      "title": "Cross-cutting",
      "items": [
        "Both runners depend on CMP-SEC before executing anything they did not build themselves.",
        "CMP-EXT → CMP-PLG is how a target adapter for a specific board is supplied."
      ]
    }
  ]
