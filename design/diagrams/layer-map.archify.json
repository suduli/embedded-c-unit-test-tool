  "cards": [
    {
      "dot": "cyan",
      "title": "How to read it",
      "items": [
        "An arrow means at least one component in the source layer depends on a component in the target layer.",
        "The label is how many such dependencies exist — 69 edges in all.",
        "Dependencies inside a single layer are not shown here; the per-layer diagrams draw them."
      ]
    },
    {
      "dot": "amber",
      "title": "Cross-cutting",
      "items": [
        "Dashed arrows point upward into L6, which a strict layering would forbid.",
        "They are legal only because CMP-PLG and CMP-SEC are marked cross_cutting in the register.",
        "Every other arrow runs downward; the checker fails the build on any upward edge that is not cross-cutting."
      ]
    },
    {
      "dot": "slate",
      "title": "Source",
      "items": [
        "Derived from design/trace/design-elements.yaml, the authoritative register.",
        "24 components, 7 layers, 69 depends_on edges.",
        "trace_check.py --check-diagrams fails CI if this diagram and the register disagree."
      ]
    }
