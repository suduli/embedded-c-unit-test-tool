  "cards": [
    {
      "dot": "cyan",
      "title": "One direction of truth",
      "items": [
        "SRS-001 says what the tool must do; the register says where each requirement is discharged.",
        "The SDD documents are the human-readable rendering of the register — where the two disagree, the SDD is defective, not the register."
      ]
    },
    {
      "dot": "emerald",
      "title": "What the gate actually stops",
      "items": [
        "An unallocated requirement, a reference to one that does not exist, an upward layer dependency, or a cycle in the component graph.",
        "A diagram that draws a component or an edge the register does not have, or omits one belonging to a component it owns."
      ]
    },
    {
      "dot": "slate",
      "title": "Where to start reading",
      "items": [
        "New to the design: the component index, then the layer map, then SDD-001.",
        "Tracing one requirement: the requirement matrix, then the SDD section for the component it lands in."
      ]
    }
