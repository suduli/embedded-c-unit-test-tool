  "cards": [
    {
      "dot": "cyan",
      "title": "Entry points",
      "items": [
        "CLI first, local web UI second — both call the same application workflows",
        "Loopback API: explicit interface, per-session secret, origin validation",
        "No network or AI dependency in the core analyze/build/test/report loop"
      ]
    },
    {
      "dot": "emerald",
      "title": "Worker pipeline",
      "items": [
        "Isolated native workers under one process supervisor and job queue",
        "Analyze → generate harness/stubs → build → execute → decode coverage",
        "One fresh host process per test; future target runtime stays a dashed adapter boundary"
      ]
    },
    {
      "dot": "amber",
      "title": "Evidence",
      "items": [
        "SQLite metadata beside a content-addressed immutable artifact store",
        "Reports merge results, coverage and requirement traceability from stored snapshots",
        "Every result is labeled with the exact source, build and tool identities"
      ]
    }
  ]
